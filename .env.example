# Copia este archivo como .env y completa los valores.
NODE_ENV=production
PORT=3001
# Escucha solo en el propio servidor (el público entra por nginx o Caddy)
HOST=127.0.0.1

# Clave para firmar las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dirección pública del registro (la que va dentro de los QR). Sin barra final.
PUBLIC_URL=https://registry.wildwood-training.com

# Prefijo de los números de registro (ej. WWT-2026-7KQ4MX)
REG_PREFIX=WWT

# Zona horaria para calcular vencimientos (lista IANA)
APP_TIMEZONE=America/Bogota

# Carpeta de datos: base de datos, fotos y respaldos
DATA_DIR=/var/lib/wildwood-registry

# Duración de la sesión en horas
SESSION_HOURS=8

BRAND_NAME=Wildwood Training
REGISTRY_NAME=Wildwood Service Dog Registry
BRAND_SITE_URL=https://wildwood-training.com/

# Número de copias diarias de la base de datos a conservar
BACKUP_KEEP=14

# Copia fuera del servidor con rclone (opcional, recomendado). Ej: r2:wildwood-respaldos
BACKUP_REMOTE=
